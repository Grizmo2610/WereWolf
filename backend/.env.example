GEMINI_API_KEYS=key1,key2,key3
OPENAI_API_KEYS=sk-or-your-openrouter-key

GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=inclusionai/ling-3.0-flash:free
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Ollama local — đặt OLLAMA_ENABLED=true nếu đã cài và chạy Ollama
OLLAMA_ENABLED=false
OLLAMA_MODEL=phi3:mini

# Qwen3.6-35B-A3B self-hosted qua vLLM (OpenAI-compatible) — đặt QWEN_VLLM_ENABLED=true nếu endpoint đang chạy
QWEN_VLLM_ENABLED=false
QWEN_VLLM_BASE_URL=https://chatbot-vllm-qwen36-35b-a3b.seabank.com.vn/Qwen3.6-35B-A3B/v1
QWEN_VLLM_MODEL=Qwen3.6-35B-A3B
QWEN_VLLM_API_KEY=
QWEN_VLLM_TIMEOUT_SECONDS=120

GEMINI_DELAY_SECONDS=2
OPENAI_DELAY_SECONDS=2
OLLAMA_DELAY_SECONDS=1
QWEN_VLLM_DELAY_SECONDS=2

# Thời gian tối thiểu mỗi lượt nói (giây), kể cả think + speak
MIN_TURN_SECONDS=30
# Số lần retry khi API trả format sai
API_RETRY_COUNT=2

MAX_TURNS_PER_DAY=40
DISCUSSION_TIMEOUT_SECONDS=300
NIGHT_DISCUSSION_MIN_SECONDS=30
NIGHT_DISCUSSION_MAX_TURNS=20

DB_PATH=./backend/logs/game.db
LOG_DIR=./backend/logs
